# API base path used by the browser. "/api" is proxied to the backend by next.config.mjs.
NEXT_PUBLIC_API_URL=/api

# Where the Next.js server forwards /api requests (server-side only)
BACKEND_URL=http://localhost:5000

# Optional: pre-fill the login boxes (set real values in .env.local, never commit them)
NEXT_PUBLIC_LOGIN_EMAIL=
NEXT_PUBLIC_LOGIN_PASSWORD=
